# Supabase project URL + public anon key are safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Never prefix with NEXT_PUBLIC_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Configure this from the TideCloak app initializer. Keep its client config out of source control.
TIDECLOAK_CONFIG_PATH=./tidecloak.json

# Used only to HMAC request network identifiers before short-lived rate limiting.
RATE_LIMIT_SECRET=

# Canonical deployed HTTPS origin, used for generated staff invitation URLs.
NEXT_PUBLIC_APP_URL=
